{
  "appId": "com.wppproject.app",
  "productName": "WPP App",
  "publish": [
    {
      "provider": "github",
      "owner": "fernandolimati",
      "repo": "wpp-project"
    }
  ],
  "win": {
    "target": "nsis",
    "icon": "resources/icon.ico"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "resources/icon.icns",
    "hardenedRuntime": true,
    "gatekeeperAssess": false
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "resources/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "files": [
    "out/**/*",
    "node_modules/**/*"
  ],
  "asar": true
}
